# Copy this file to .env and fill in your values.

# Use "gemini" for fast API-based responses (no GPU needed).
# Use "medgemma" to run the model locally (requires HuggingFace token + GPU/MPS).
MODEL_BACKEND=gemini

# Required when MODEL_BACKEND=gemini
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required when MODEL_BACKEND=medgemma (local only)
# HF_TOKEN=hf_your_huggingface_token_here

# Cloud Storage bucket name (for Google Cloud Run deployment)
# Leave empty to use local JSON files during development
# GCS_BUCKET=your-gcs-bucket-name

# ── Optional AI assist (Anthropic Claude) ─────────────────────────────────
# Off by default. Do NOT enable with real patient data until your organization has a signed
# BAA covering the service you use. See README -> "AI assist and patient data".
# AI_ASSIST_ENABLED=true
# ANTHROPIC_API_KEY=your_key_here            # AI_PROVIDER=anthropic (default)
# AI_PROVIDER=vertex                         # or use Claude through Google Cloud Vertex AI:
# GCP_PROJECT=your-gcp-project
# GCP_REGION=global
# Models by reasoning tier (these are the defaults):
# AI_MODEL_TRIAGE=claude-haiku-5-5
# AI_MODEL_SUMMARY=claude-sonnet-5-5
# AI_MODEL_REVIEW=claude-opus-5-5
